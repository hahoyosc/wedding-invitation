---
import "../styles/global.css";
import EnvelopeIntro from "../components/EnvelopeIntro.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>¡Sara y Julián se casan!</title>
    <link
      rel="preload"
      as="font"
      type="font/otf"
      href="/fonts/amoresa-aged.otf"
      crossorigin
    />
  </head>
  <body>
    <EnvelopeIntro />
    <div id="page-content" class="origin-bottom">
      <slot />
    </div>
  </body>
</html>

<style>
  #page-content {
    opacity: 0;
    scale: 0;
    transform-origin: bottom center;
    transition:
      scale 1s cubic-bezier(0.25, 1.1, 0.5, 1),
      opacity 1s ease-out;
  }

  #page-content.is-open {
    opacity: 1;
    scale: 1;
  }
</style>
